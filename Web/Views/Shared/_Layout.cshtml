@using Inertia.Core
@{
    var page = ViewData["page"] as Page;
    var pageJson = ViewData["pageJson"] as string ?? "{}";
    var ssrHtml = ViewData["ssrHtml"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(page?.Component ?? "Inertia App")</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="app" data-page="@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(pageJson))">
        @if (!string.IsNullOrEmpty(ssrHtml))
        {
            @Html.Raw(ssrHtml)
        }
    </div>

    <script>
        window.__INERTIA_PAGE__ = @Html.Raw(pageJson);
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="~/js/app.jsx" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
