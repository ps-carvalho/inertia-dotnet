@using Inertia.Core
@using Web.Helpers
@inject ViteManifestReader ViteManifest
@{
    Layout = null;
    var page = ViewData["page"] as Page;
    var pageJson = ViewData["pageJson"] as string ?? "{}";
    var ssrHtml = ViewData["ssrHtml"] as string;

    var jsPath = ViteManifest.GetAssetPath("src/app.jsx");
    var cssFiles = ViteManifest.GetCssFiles("src/app.jsx");
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(page?.Component ?? "Inertia App")</title>
    @foreach (var css in cssFiles)
    {
        <link rel="stylesheet" href="@css" />
    }
</head>

<body>
    <div id="app" data-page='@Html.Raw(pageJson)'>
        @if (!string.IsNullOrEmpty(ssrHtml))
        {
            @Html.Raw(ssrHtml)
        }
    </div>

    <script>
            window.__INERTIA_PAGE__ = @Html.Raw(pageJson);
    </script>

 
    @if (!string.IsNullOrEmpty(jsPath))
    {
        <script type="module" src="@jsPath"></script>
    }
    else
    {
        <div style="background: #fff3cd; padding: 1rem; margin: 1rem; border: 1px solid #ffc107; border-radius: 4px;">
            <strong>Development Mode:</strong> Run <code>npm run build</code> to build assets, or <code>npm run dev</code>
            for the Vite dev server.
        </div>
    }
</body>

</html>
